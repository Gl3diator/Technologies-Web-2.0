{% extends 'base.html.twig' %}

{% block title %}Add New Book{% endblock %}
{% block page_title %}Add New Book{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card my-4">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3">
                        <h6 class="text-white text-capitalize ps-3">Add New Book</h6>
                    </div>
                </div>
                <div class="card-body px-0 pb-2">
                    <div class="row">
                        <div class="col-md-8 mx-auto">
                            {{ form_start(form, {'attr': {'class': 'p-4'}}) }}
                            
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">Reference</label>
                                            {{ form_widget(form.ref, {'attr': {'class': 'form-control', 'placeholder': 'Enter book reference'}}) }}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">Title</label>
                                            {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Enter book title'}}) }}
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">Category</label>
                                            {{ form_widget(form.category, {'attr': {'class': 'form-control'}}) }}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">Author</label>
                                            {{ form_widget(form.author, {'attr': {'class': 'form-control'}}) }}
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">Publication Date</label>
                                            {{ form_widget(form.publicationDate, {'attr': {'class': 'form-control'}}) }}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mt-4">
                                            <div class="form-check form-switch">
                                                {{ form_widget(form.published, {'attr': {'class': 'form-check-input', 'role': 'switch'}}) }}
                                                <label class="form-check-label ms-2">Published</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="text-center mt-4">
                                    <button type="submit" class="btn btn-lg bg-gradient-primary btn-lg w-100 mt-4 mb-0">Create Book</button>
                                </div>
                            
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-3">
                <a href="{{ path('app_book') }}" class="btn btn-outline-secondary">
                    <i class="material-symbols-rounded">arrow_back</i>
                    Back to Book List
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}