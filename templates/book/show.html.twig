{% extends 'base.html.twig' %}

{% block title %}Book Details: {{ book.title }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Book Details</h1>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">{{ book.title }}</h5>
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Reference:</strong> {{ book.ref }}</p>
                    <p><strong>Category:</strong> {{ book.category }}</p>
                    <p><strong>Published:</strong> {{ book.published ? 'Yes' : 'No' }}</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Author:</strong> {{ book.author.username }}</p>
                    <p><strong>Author Email:</strong> {{ book.author.email }}</p>
                    <p><strong>Publication Date:</strong> {{ book.publicationDate|date('Y-m-d') }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_book') }}" class="btn btn-secondary">Back to List</a>
        <a href="{{ path('app_book_edit', {'id': book.id}) }}" class="btn btn-warning">Edit</a>
    </div>
</div>
{% endblock %}