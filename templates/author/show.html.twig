<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Auteur - {{ name }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
            padding: 2rem 0;
        }
        .author-container {
            max-width: 600px;
            margin: 0 auto;
        }
        .author-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
         .author-image {
            max-width: 200px;  /* Réduit de 300px à 200px */
            height: auto;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>
    <div class="container author-container">
        <div class="card author-card">
            <div class="card-header bg-primary text-white text-center py-3">
                <h3 class="mb-0">Fiche Auteur</h3>
            </div>
            <div class="card-body text-center p-4">
                <h4 class="text-primary mb-3">Nom de l'auteur :</h4>
                <h2 class="display-6">{{ name }}</h2>
                <p class="text-muted mt-4">Ceci est la page de présentation de l'auteur</p>
                
                <div class="mt-4">
                    <a href="{{ path('app_author_index') }}" class="btn btn-primary me-2">
                        Lien 1                        
                    </a>
                    <a href="/" class="btn btn-outline-secondary">
                        Lien 2
                    </a>
                </div>

            </div>
        </div>
    </div>

                 <div class="text-center">
            <img src="public/images/image.jpg" 
                 alt="Image auteur" 
                 class="author-image">
            <p class="text-muted mt-2">Portrait de l'auteur</p>
        </div>
</body>
</html>