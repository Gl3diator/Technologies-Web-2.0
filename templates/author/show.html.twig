{% extends 'base.html.twig' %}

{% block title %}Auteur{% endblock %}

{% block page_title %}Auteurs{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        {% if name is defined and name is not empty %}
            <!-- AFFICHAGE NORMAL QUAND UN AUTEUR EST SPÉCIFIÉ -->
            <div class="card my-4">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3">
                        <h6 class="text-white text-capitalize ps-3">Fiche Auteur</h6>
                    </div>
                </div>
                <div class="card-body px-0 pb-2 text-center">
                    <div class="px-4 py-3">
                        <h5 class="mb-3">Nom de l'auteur :</h5>
                        <h2 class="text-gradient text-primary">{{ name }}</h2>
                        <p class="mt-4 text-secondary">Ceci est la page de présentation de l'auteur</p>
                    </div>
                </div>
            </div>

            <div class="card my-4">
                <div class="card-body text-center">
                    <img src="{{ asset('images/image.jpg') }}" 
                         alt="Image auteur" 
                         class="img-fluid rounded shadow" 
                         style="max-width: 200px;">
                    <p class="text-muted mt-2">Portrait de l'auteur</p>
                </div>
            </div>

        {% else %}
    <script>window.location.href = "{{ path('showAll') }}";</script>
{% endif %}
    </div>
</div>
{% endblock %}